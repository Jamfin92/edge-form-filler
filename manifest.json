{
  "manifest_version": 3,
  "name": "Form Filler & Lorem Ipsum",
  "version": "1.0.0",
  "description": "Autofill forms with realistic sample data and fill long text boxes with Lorem Ipsum. Built for development and testing.",
  "permissions": ["storage", "contextMenus", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lorem.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "fill-forms": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill forms on the current page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
